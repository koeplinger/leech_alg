\\ 04_pari_crosscheck.gp -- independent PARI/GP computation of the span index
\\ [Lambda : S_g] for the twists exported by 03_twist_census.py.
\\ Input: pari_input_matrices.gp, MATS[k] = 576 x 24 integer matrix whose row
\\ 24*(i-1)+j holds the Lambda-coordinates of the product b_i *_g b_j.
\\ For each matrix M: H = mathnf(M~) (HNF of the Z-module generated by the
\\ columns of M~, i.e. by the 576 product vectors), rank = #columns of H,
\\ index = |det H|, elementary divisors via matsnf(H) and, separately,
\\ matsnf(M~) on the full rectangular matrix; F2-rank of M mod 2.
\\ Output line per matrix:  k | name | rank | index | log2 | SNF(H) != 1 | SNF(M~) != 1 | F2-rank
\\ Run:  gp -q 04_pari_crosscheck.gp > 04_pari_crosscheck.out.txt
\\ (default PARI stack suffices for these 108 matrices)
read("pari_input_matrices.gp");
nontriv(d) = select(x -> x != 1, d);
{
for (k = 1, #MATS,
  M = MATS[k];
  H = mathnf(M~);
  rk = matsize(H)[2];
  idx = if (rk == 24, abs(matdet(H)), 0);
  d1 = nontriv(matsnf(H));
  d2 = nontriv(matsnf(M~));
  r2 = matrank(M * Mod(1, 2));
  print(k, " | ", NAMES[k], " | ", rk, " | ", idx, " | ",
        if (idx > 0 && idx == 2^valuation(idx, 2), valuation(idx, 2), "n/a"),
        " | ", d1, " | ", d2, " | ", r2);
);
}
quit;
