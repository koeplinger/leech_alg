\\ =========================================================================
\\ c3_witness.gp -- PARI/GP-only, exact, end-to-end recomputation of the
\\ span index of the triple product twisted by a root reflection of E8.
\\
\\ Run:  gp -q c3_witness.gp > c3_witness.gp.out
\\ Tested with PARI/GP 2.15.4.  All arithmetic is exact (integers and
\\ rationals); nothing is floating point.
\\
\\ CONVENTIONS (each taken from main.tex v8 of "An order on the Leech
\\ lattice from a Z3-symmetric triple-octonion product"):
\\  * Octonions O with basis e0..e7, e0 the identity.  A vector is a GP
\\    column vector of length 8 whose entry k+1 is the coefficient of e_k.
\\  * Fano triples (1,2,4),(2,3,5),(3,4,6),(4,5,7),(5,6,1),(6,7,2),(7,1,3):
\\    for a triple (a,b,c), e_a e_b = e_c, e_b e_c = e_a, e_c e_a = e_b, the
\\    reversed products carry a minus sign, and e_i^2 = -e0 for i >= 1.
\\  * L = D8+ = vectors whose coordinates are all integers with even sum,
\\    or all half-odd-integers with ODD sum.  Roots have norm 2.
\\  * s = (-e0+e1+...+e7)/2 (in L), sbar = (-e0-e1-...-e7)/2 (not in L).
\\  * L sbar = { l . sbar : l in L } and L s = { l . s : l in L }: LEFT
\\    multiples, the lattice element is the LEFT factor (paper eq. disp1).
\\  * Wilson's Leech lattice:
\\      Lambda = {(x,y,z) in L^3 : x+y, x+z, y+z in L sbar ; x+y+z in L s}.
\\    A 24-vector is the concatenation (x | y | z).
\\  * Twisted product: x ._g y := g^{-1}( g(x) . g(y) ).  For the paper's
\\    sigma (and for every reflection) g = g^{-1}, so this is the paper's
\\    eq. (twist-formula) x ._sigma y = sigma(sigma(x) . sigma(y)), and the
\\    twist direction (g versus g^{-1}) cannot matter.
\\  * Root reflection: s_r(x) = x - <x,r> r for a root r (<r,r> = 2);
\\    its matrix is I - r r^T.  sigma = (1 2) is s_r for r = e1 - e2.
\\  * Triple product with Z3 routing (Definition 3.3), u = (x,y,z),
\\    v = (x',y',z'), every block product being ._g:
\\      P1 = x.x' + z.y' + y.z'
\\      P2 = y.y' + x.z' + z.x'
\\      P3 = z.z' + y.x' + x.y'
\\  * Span index: S_g = Z-span{u *_g v : u, v in Lambda}, generated by the
\\    576 products of a Z-basis of Lambda (bilinearity); [Lambda : S_g] is
\\    |det| of the Hermite normal form of their Lambda-coordinates.
\\
\\ THE WITNESS UNDER TEST (claim C3): r = (e0+e1+e2+e3+e4+e5+e6-e7)/2,
\\ claimed: closes on Lambda, span index 1.  The paper's sigma (root e1-e2,
\\ claimed index 2^16) and the untwisted product (claimed not to close) are
\\ run through the identical pipeline as controls.
\\ =========================================================================

default(parisizemax, 2*10^9);

\\ ---------- 1. octonion multiplication from the Fano triples ------------
fano = [[1,2,4],[2,3,5],[3,4,6],[4,5,7],[5,6,1],[6,7,2],[7,1,3]];
SG = matrix(8,8); IX = matrix(8,8);   \\ e_a e_b = SG[a+1,b+1] * e_{IX[a+1,b+1]}
for(a=0,7, SG[1,a+1]=1; IX[1,a+1]=a; SG[a+1,1]=1; IX[a+1,1]=a);
for(a=1,7, SG[a+1,a+1]=-1; IX[a+1,a+1]=0);
{
for(t=1,7, my(a=fano[t][1], b=fano[t][2], c=fano[t][3]);
  SG[a+1,b+1]= 1; IX[a+1,b+1]=c;  SG[b+1,c+1]= 1; IX[b+1,c+1]=a;
  SG[c+1,a+1]= 1; IX[c+1,a+1]=b;
  SG[b+1,a+1]=-1; IX[b+1,a+1]=c;  SG[c+1,b+1]=-1; IX[c+1,b+1]=a;
  SG[a+1,c+1]=-1; IX[a+1,c+1]=b);
}
\\ every ordered pair of distinct imaginary units must be covered exactly once
{
my(cnt=matrix(8,8));
for(t=1,7, my(f=fano[t]); for(i=1,3, for(j=1,3, if(i!=j, cnt[f[i]+1,f[j]+1]++))));
for(a=2,8, for(b=2,8, if(a!=b && cnt[a,b]!=1, error("Fano table not a Steiner system"))));
}
omul(x,y) = {
  my(z=vectorv(8));
  for(a=1,8, if(x[a], for(b=1,8, if(y[b], z[IX[a,b]+1] += SG[a,b]*x[a]*y[b]))));
  z;
}
E(k) = { my(v=vectorv(8)); v[k+1]=1; v; }    \\ e_k
nrm(x) = sum(i=1,#x, x[i]^2);                  \\ squared Euclidean norm

\\ ---------- 2. the lattice L = D8+ and the sublattices L sbar, L s ------
inL(x) = {
  my(d=denominator(x));
  if(d==1, return(sum(i=1,8,x[i])%2==0));
  if(d==2, for(i=1,8, if(denominator(x[i])!=2, return(0)));
           return( (2*sum(i=1,8,x[i]))%4==2 ));   \\ sum is odd  <=> 2*sum = 2 mod 4
  0;
}
s    = vectorv(8,i, if(i==1,-1/2, 1/2));
sbar = vectorv(8,i, -1/2);
\\ basis of L from Appendix A of the paper: L1=s, L2=e0+e1, L3=e0-e1, L_{k+2}=e0+e_k (k=2..6)
LB = matconcat([s, E(0)+E(1), E(0)-E(1), E(0)+E(2), E(0)+E(3), E(0)+E(4), E(0)+E(5), E(0)+E(6)]);
for(k=1,8, if(!inL(LB[,k]), error("basis vector not in D8+")));
printf("[conv] L basis: all 8 vectors in D8+; Gram det = %s (E8 is unimodular at root norm 2)\n", matdet(LB~*LB));
printf("[conv] s in L: %d, sbar in L: %d, N(s) = %s, N(sbar) = %s\n", inL(s), inL(sbar), nrm(s), nrm(sbar));

\\ coordinates with respect to a basis matrix B (columns); 0 if not integral
coords(B, x) = { my(c=matsolve(B,x)); if(denominator(c)==1, c, 0); }
inlat(B, x) = denominator(matsolve(B,x)) == 1;

AB0 = matconcat(vector(8,k, omul(LB[,k], sbar)));   \\ L sbar, left multiples
BB0 = matconcat(vector(8,k, omul(LB[,k], s)));      \\ L s,    left multiples
IL(B) = abs(matdet(matsolve(LB,B)));                 \\ index in L of a full sublattice
printf("[conv] [L : L sbar] = %s, [L : L s] = %s\n", IL(AB0), IL(BB0));
printf("[conv] L sbar + L s = L : %d\n", IL(mathnf(matconcat([matsolve(LB,AB0), matsolve(LB,BB0)])))==1 );
{
my(ok=1); for(k=1,8, if(!inlat(AB0,2*LB[,k]) || !inlat(BB0,2*LB[,k]), ok=0));
printf("[conv] 2L in both; with |A||B| = |A+B||A cap B| this gives L sbar cap L s = 2L : %d\n", ok && IL(AB0)*IL(BB0)==256);
}
SIG = matid(8); SIG[2,2]=0; SIG[3,3]=0; SIG[2,3]=1; SIG[3,2]=1;
\\ paper Remark 4.6 (pins down the product and the left-multiple convention)
u1=[-1,0,0,0,1,0,1,1]~; u2=[-1,1,0,0,0,1,0,1]~;
{
printf("[conv] Remark 4.6: u1,u2 in Ls: %d %d; u1.u2 = %s (paper: [0,-2,2,1,-2,-1,-1,-1]); in L sbar: %d; in L s: %d\n",
  inlat(BB0,u1), inlat(BB0,u2), omul(u1,u2)~, inlat(AB0,omul(u1,u2)), inlat(BB0,omul(u1,u2)));
v46=[-1,0,1,0,0,1,0,1]~; w46=[0,0,-1,0,-1,0,-1,-1]~;
printf("[conv] Remark 4.6: v in sigma(Ls) \\ Ls: %d ; w in sigma(L sbar) \\ L sbar: %d\n",
  inlat(SIG*BB0,v46) && !inlat(BB0,v46), inlat(SIG*AB0,w46) && !inlat(AB0,w46));
}
\\ paper Appendix A: M_k = sigma(L_k . s), N_k = sigma(L_k . sbar), sigma = (1 2)
printf("[conv] Appendix A: M_1 = %s (paper [-3/2,-1/2,...]), M_2 = %s (paper [-1,0,0,0,1,0,1,1])\n", (SIG*BB0[,1])~, (SIG*BB0[,2])~);
printf("[conv] Appendix A: N_1 = %s (paper [2,0,...]),        N_2 = %s (paper [0,0,-1,0,-1,0,-1,-1])\n", (SIG*AB0[,1])~, (SIG*AB0[,2])~);

\\ ---------- 3. Wilson's Leech lattice Lambda --------------------------------
\\ In L-coordinates c = (cx,cy,cz) in Z^24, x+y in L sbar <=> (2 PA^{-1})(cx+cy) = 0 mod 2,
\\ where PA = L sbar basis in L-coordinates (2L inside L sbar makes 2 PA^{-1} integral).
\\ Lambda contains 2L^3, so Lambda = 2Z^24 + lift of the F2-kernel of the conditions.
PA = matsolve(LB, AB0); PB = matsolve(LB, BB0);
QA = 2*PA^(-1); QB = 2*PB^(-1);
if(denominator(QA)!=1 || denominator(QB)!=1, error("2L not inside L sbar or L s"));
Z8 = matrix(8,8);
K = matconcat([QA, QA, Z8; QA, Z8, QA; QB, QB, QB]);
KER = matkermod(K, 2);
printf("[Lambda] dim over F2 of Lambda/2L^3 = %d (expect 12, i.e. [L^3 : Lambda] = 2^12)\n", #KER);
LamC = mathnf(matconcat([lift(KER), 2*matid(24)]));     \\ Lambda in L^3-coordinates
LB3 = matconcat([LB, Z8, Z8; Z8, LB, Z8; Z8, Z8, LB]);
LamB = LB3 * LamC;                                         \\ Lambda basis in R^24 (columns)
GramLam = LamB~ * LamB;
printf("[Lambda] Gram determinant = %s = 2^%d\n", matdet(GramLam), valuation(matdet(GramLam),2));
mn = qfminim(GramLam, 7, 0, 2);   \\ count vectors of norm <= 7 (should be none)
printf("[Lambda] number of nonzero vectors of norm <= 7: %d\n", mn[1]);
mn = qfminim(GramLam, 8, 0, 2);
printf("[Lambda] number of vectors of norm 8: %d (expect 196560)\n", mn[1]);

\\ Wilson membership test straight from the definition (independent of LamB)
inLambda(P) = {
  my(x=P[1..8], y=P[9..16], z=P[17..24]);
  inL(x) && inL(y) && inL(z) && inlat(AB0,x+y) && inlat(AB0,x+z) && inlat(AB0,y+z) && inlat(BB0,x+y+z);
}
{
my(ok=1); for(k=1,24, if(!inLambda(LamB[,k]), ok=0));
printf("[Lambda] all 24 basis vectors pass Wilson's three conditions: %d\n", ok);
}

\\ ---------- 4. twisted triple product, closure and span index ------------
\\ G = matrix of the twist g (rational 8x8 with G*L = L); Gi = G^{-1}.
tw(G, Gi, x, y) = Gi * omul(G*x, G*y);
tprod(G, Gi, u, v) = {
  my(x=u[1..8], y=u[9..16], z=u[17..24], xp=v[1..8], yp=v[9..16], zp=v[17..24]);
  concat([ tw(G,Gi,x,xp) + tw(G,Gi,z,yp) + tw(G,Gi,y,zp),
           tw(G,Gi,y,yp) + tw(G,Gi,x,zp) + tw(G,Gi,z,xp),
           tw(G,Gi,z,zp) + tw(G,Gi,y,xp) + tw(G,Gi,x,yp) ]);
}
\\ returns [closes?, number of failing basis pairs, 24x576 coordinate matrix (if closes)]
products(G) = {
  my(Gi=G^(-1), C=matrix(24,576), bad=0, P, c);
  for(i=1,24, for(j=1,24,
    P = tprod(G, Gi, LamB[,i], LamB[,j]);
    if(!inLambda(P), bad++; next);
    c = matsolve(LamB, P);
    if(denominator(c)!=1, error("Wilson test and Lambda basis disagree"));
    C[,(i-1)*24+j] = c));
  [bad==0, bad, C];
}
report(name, G) = {
  my(res, H, d, sn);
  printf("\n== twist %s ==\n", name);
  printf("   G maps L onto L: %d, G orthogonal: %d, det G = %s\n",
    IL(G*LB)==1 && denominator(matsolve(LB,G*LB))==1, G~*G==matid(8), matdet(G));
  res = products(G);
  printf("   basis-pair products failing Wilson's conditions: %d of 576  =>  closes: %d\n", res[2], res[1]);
  if(!res[1], return(0));
  H = mathnf(res[3]);
  d = matdet(H);
  sn = matsnf(H);
  printf("   rank of span = %d, [Lambda : S] = |det HNF| = %s\n", matrank(res[3]), abs(d));
  printf("   elementary divisors of Lambda/S (matsnf, entries != 1): %s\n", select(t->t!=1, sn));
  printf("   2*Lambda inside S: %d\n", denominator(matsolve(H, 2*matid(24)))==1);
  res[3];
}

\\ the witness
r = vectorv(8,i, 1/2); r[8] = -1/2;          \\ (e0+e1+...+e6-e7)/2
printf("\n[witness] r = %s : in L %d, N(r) = %s\n", r~, inL(r), nrm(r));
Rr = matid(8) - r*r~;                         \\ s_r(x) = x - <x,r> r
printf("[witness] s_r^2 = I: %d; s_r(e0) = %s (identity element of ._g)\n", Rr^2==matid(8), (Rr*E(0))~);

C0 = report("identity (untwisted product)", matid(8));
Csig = report("sigma = (1 2) = reflection in e1-e2", SIG);
Crr = report("s_r, r = (e0+e1+e2+e3+e4+e5+e6-e7)/2", Rr);

\\ ---------- 5. naive search for a 24-product basis (documented NEGATIVE result)
\\ Greedy selection among the 576 basis-pair products b_i *_g b_j: a product
\\ is kept when the chosen set still spans a PRIMITIVE sublattice of Lambda
\\ (all elementary divisors 1).  24 primitive vectors of a rank-24 lattice
\\ form a Z-basis, i.e. their coordinate matrix has determinant +-1.
\\ The candidates are visited in a random order (fixed seeds, so the run is
\\ reproducible); a run that gets stuck before 24 is restarted.
\\ OBSERVED: every run stops at 23 (the 24th vector would have to hit
\\ determinant exactly +-1).  This does NOT contradict S = Lambda (the HNF
\\ above is exact); a working construction of 24 single products forming a
\\ Z-basis is in c3_certificate.gp, checked independently by
\\ c3_certificate_check.py.
primitive(M) = { my(d=matsnf(M)); for(i=1,#d, if(d[i]!=0 && d[i]!=1, return(0))); matrank(M)==#M; }
greedy(C, ord) = {
  my(sel=List(), M=matrix(24,0), cand, Mn);
  for(t=1,#ord,
    if(#sel==24, break);
    cand = C[,ord[t]];
    if(cand==0, next);
    Mn = matconcat([M, cand]);
    if(matrank(Mn)==#sel+1 && primitive(Mn), M=Mn; listput(sel,ord[t])));
  [sel, M];
}
shuffled(n) = { my(v=vector(n,i,i), k, tmp); forstep(i=n,2,-1, k=random(i)+1; tmp=v[i]; v[i]=v[k]; v[k]=tmp); v; }
{
if(type(Crr)=="t_MAT",
  my(res, sel, M, cert, prods, GramP, runs=0, seed);
  res = greedy(Crr, vector(576,i,i)); runs=1;
  printf("\n[certificate] run 1 (natural order): %d of 24 selected\n", #res[1]);
  seed = 0;
  while(#res[1] < 24 && seed < 1000,
    seed++; setrand(seed); res = greedy(Crr, shuffled(576)); runs++);
  sel = res[1]; M = res[2];
  printf("[certificate] runs used: %d (last seed %d), selected %d basis pairs\n", runs, seed, #sel);
  if(#sel==24,
    cert = vector(24,k, [ (sel[k]-1)\24 + 1, (sel[k]-1)%24 + 1 ]);
    printf("[certificate] (i,j) pairs, product = b_i *_g b_j: %s\n", cert);
    printf("[certificate] det of their 24x24 Lambda-coordinate matrix = %s\n", matdet(M));
    \\ basis-free form: the 24 product vectors themselves, Gram determinant
    prods = matconcat(vector(24,k, tprod(Rr, Rr, LamB[,cert[k][1]], LamB[,cert[k][2]])));
    GramP = prods~ * prods;
    printf("[certificate] all 24 products pass Wilson's test: %d; Gram det of the 24 products = %s (det Lambda = 2^24 = %s)\n",
      prod(k=1,24, inLambda(prods[,k])), matdet(GramP), 2^24);
    for(k=1,24, printf("   p_%d = b_%d * b_%d = %s\n", k, cert[k][1], cert[k][2], prods[,k]~));
  ));
}
\\ also print the Lambda basis so the certificate is reproducible verbatim
printf("\n[Lambda basis] columns of LamB, each as 24 coordinates (x|y|z):\n");
for(k=1,24, printf("b_%d = %s\n", k, LamB[,k]~));
